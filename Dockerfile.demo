# Portfolio demo image: train once while building, serve predictions at runtime.
# Multi-stage build keeps the CSV, training/MLflow history and plotting tools
# out of the final runtime image.
FROM python:3.11-slim AS trainer
WORKDIR /app
ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    MPLBACKEND=Agg
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ ./src/
COPY scripts/download_data.py scripts/train_model.py ./scripts/
RUN python scripts/download_data.py && python scripts/train_model.py && \
    test -s models/best_model.joblib

FROM python:3.11-slim AS runtime
WORKDIR /app
ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
COPY requirements.serve.txt ./
RUN pip install --no-cache-dir -r requirements.serve.txt && \
    useradd --create-home --uid 10001 appuser
COPY --from=trainer /app/models/best_model.joblib ./models/best_model.joblib
COPY src/ ./src/
RUN chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn churn_mlops.api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
